{
  "args": { "month": "2026-05" },
  "expect": {
    "rowCount": { "min": 28, "max": 32 },
    "columns": ["month", "date", "weekday", "projectId", "category", "activity", "hours", "status", "journalId", "lineNumber"],
    "types": {
      "month": "string",
      "date": "string",
      "weekday": "string",
      "projectId": "string",
      "category": "string",
      "activity": "string",
      "hours": "number",
      "status": "string",
      "journalId": "string",
      "lineNumber": "number"
    },
    "patterns": {
      "month": "^\\d{4}-\\d{2}$",
      "date": "^\\d{4}-\\d{2}-\\d{2}$",
      "weekday": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun)$",
      "projectId": "^PID",
      "journalId": "^J\\d",
      "status": "^[A-Z]+$"
    },
    "notEmpty": ["month", "date", "weekday", "projectId", "category", "activity", "status", "journalId"]
  }
}
